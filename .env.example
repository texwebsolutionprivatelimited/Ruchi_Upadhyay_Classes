# -------------------------------------------------------------
# SUPABASE CONFIGURATION
# -------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# -------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# -------------------------------------------------------------
# 1. PUBLIC KEY ID (Visible in Frontend for payment popup - UPI, Cards, Netbanking, QR)
# Replace with your actual Key ID from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# 2. PRIVATE KEY SECRET (Used only by Vercel Serverless to cryptographically verify payments)
# Replace with your actual Key Secret. On Vercel, also add this in Project Settings -> Environment Variables
RAZORPAY_KEY_SECRET="your_razorpay_secret_placeholder_here"
